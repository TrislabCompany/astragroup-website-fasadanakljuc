# The headers Cloudflare Pages sends with the site's files: security headers on
# every answer, and caching. Pages already asks browsers to check every other
# file again on each visit (max-age=0, must-revalidate).
#
# Different rules that match a path add their headers together, so set each
# header in one rule only. Two rules with the same path don't add up: only the
# last counts.
#
# The quote form (/povprasevanje, src/components/QuoteForm.astro) loads
# Cloudflare Turnstile and posts to the form Worker of each Environment, so the
# one policy allows challenges.cloudflare.com in script-src and frame-src and
# the three Workers in form-action. It is set here, once, and not in a rule of
# the form page: two rules that match a page send two policies, and the
# stricter one would block Turnstile (docs/forms.md, section 3).
#
# "! Access-Control-Allow-Origin" removes the header Pages adds by default:
# no other site needs to read these files.

/*
  ! Access-Control-Allow-Origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://forms-dev.trislab.com https://forms-staging.trislab.com https://forms.trislab.com; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed assets never change: the browser keeps them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Written at deploy, per Environment, by scripts/write-config.mjs.
/config.json
  Cache-Control: no-store
