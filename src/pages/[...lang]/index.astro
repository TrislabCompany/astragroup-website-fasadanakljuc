---
// The home page, top to bottom (docs/brief.md): the hero with one promise and
// the two paths, the process at a glance, the facade systems in short, the
// subsidy note and the quote request. The footer follows from the layout.
import HeroFacade from "../../components/HeroFacade.astro";
import PathChooser from "../../components/PathChooser.astro";
import ProcessLine from "../../components/ProcessLine.astro";
import QuoteCta from "../../components/QuoteCta.astro";
import SystemCards from "../../components/SystemCards.astro";
import { languagePaths, localizedPath, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../site.config";
import { pageTexts } from "../../texts";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const { home } = pageTexts(lang);
---

<BaseLayout title={`${site.name}: ${home.intro.title}`} description={home.intro.description} lang={lang}>
  <section class="hero">
    <div class="wrap hero-row">
      <div class="hero-text">
        <p class="eyebrow">{home.intro.eyebrow}</p>
        <h1>{home.intro.title}</h1>
        <p class="lead">{home.intro.lead}</p>
        <h2 class="paths-heading">{home.pathsHeading}</h2>
        <PathChooser lang={lang} />
      </div>
      <HeroFacade />
    </div>
  </section>
  <ProcessLine lang={lang} id="steps" heading={home.stepsHeading} lead={home.stepsLead} steps={home.steps} owner={false}>
    <p class="band-link"><a href={localizedPath(lang, "/prenova-fasade")}>{t(lang, "cta.renovationSteps")}</a></p>
  </ProcessLine>
  <section class="band" aria-labelledby="systems">
    <div class="wrap">
      <h2 id="systems">{home.systemsHeading}</h2>
      <p class="lead">{home.systemsLead}</p>
      <SystemCards lang={lang} level={3} compact />
      <p class="band-link"><a href={localizedPath(lang, "/vrste-fasad")}>{t(lang, "cta.systems")}</a></p>
    </div>
  </section>
  <section class="band band-surface" aria-labelledby="subsidy">
    <div class="wrap subsidy-note">
      <h2 id="subsidy">{home.subsidyHeading}</h2>
      <p>{home.subsidyText}</p>
      <p class="band-link"><a href={localizedPath(lang, "/subvencije")}>{t(lang, "cta.subsidy")}</a></p>
    </div>
  </section>
  <QuoteCta lang={lang} />
</BaseLayout>
