---
// Prenova fasade: when to renovate, the six steps with what the owner does at
// each, what is included, the subsidy note and the quote request.
import Checklist from "../../components/Checklist.astro";
import PageIntro from "../../components/PageIntro.astro";
import ProcessLine from "../../components/ProcessLine.astro";
import QuoteCta from "../../components/QuoteCta.astro";
import TextBlocks from "../../components/TextBlocks.astro";
import { languagePaths, localizedPath, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTexts } from "../../texts";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const { renovation } = pageTexts(lang);
---

<BaseLayout title={renovation.intro.title} description={renovation.intro.description} lang={lang}>
  <PageIntro intro={renovation.intro} />
  <TextBlocks blocks={[renovation.when]} />
  <ProcessLine lang={lang} id="steps" heading={renovation.stepsHeading} steps={renovation.steps} />
  <Checklist id="included" heading={renovation.includedHeading} items={renovation.included} />
  <TextBlocks blocks={[renovation.subsidy]} surface>
    <p class="band-link"><a href={localizedPath(lang, "/subvencije")}>{t(lang, "cta.subsidy")}</a></p>
  </TextBlocks>
  <QuoteCta lang={lang} />
</BaseLayout>
