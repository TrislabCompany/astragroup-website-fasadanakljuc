---
// The quote request form, in the brief's four steps (docs/brief.md): (1) the
// case, (2) the building, (3) the wish, (4) how to reach the visitor and their
// consent. It is a plain form post with no JavaScript: the steps are four
// numbered fieldsets on one page, and the browser checks the required fields,
// showing each error next to its field. The Worker checks everything again.
//
// The Worker's address and the Turnstile site key differ per Environment, and
// one build runs in all of them, so the script below reads them from
// /config.json (src/lib/quote-form.ts). Until it has both, the button is off
// and a note says why; with them it sets the form's action, adds the Turnstile
// widget and switches the button on.
import { localizedPath, t, type Lang } from "../i18n";
import { LEGAL_PATHS } from "../lib/navigation";
import { quoteForm } from "../lib/quote-form";
import { pageTexts } from "../texts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { quote } = pageTexts(lang);
const { building, wish, contact } = quote;
const step = (number: number, legend: string) => `${quote.stepLabel} ${number}: ${legend}`;
---

<form class="quote-form" method="post" aria-describedby="form-off" data-quote-form data-turnstile-action={quoteForm.turnstileAction}>
  <fieldset class="form-step">
    <legend>{step(1, quote.case.legend)}</legend>
    <div class="choices">
      {
        quote.case.choices.map((choice, index) => (
          <label class="choice">
            <input type="radio" name="primer" value={choice.value} required={index === 0} />
            <span>{choice.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="form-step">
    <legend>{step(2, building.legend)}</legend>
    <div class="field">
      <label for="vrsta-hise">{building.houseType}</label>
      <select id="vrsta-hise" name="vrsta_hise" required>
        <option value="">{quote.choose}</option>
        {building.houseTypes.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="starost">{building.age}</label>
      <select id="starost" name="starost_hise" required>
        <option value="">{quote.choose}</option>
        {building.ages.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="povrsina">{building.area} <span class="optional">({quote.optional})</span></label>
      <input id="povrsina" name="povrsina" type="number" inputmode="numeric" min="1" max="10000" step="1" aria-describedby="povrsina-hint" />
      <p class="hint" id="povrsina-hint">{building.areaHint}</p>
    </div>
    <div class="field">
      <label for="obcina">{building.municipality}</label>
      <input id="obcina" name="obcina" type="text" autocomplete="address-level2" required />
    </div>
  </fieldset>

  <fieldset class="form-step">
    <legend>{step(3, wish.legend)}</legend>
    <div class="field">
      <label for="dela">{wish.work}</label>
      <select id="dela" name="vrsta_del" required>
        <option value="">{quote.choose}</option>
        {wish.works.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="rok">{wish.timeframe}</label>
      <select id="rok" name="rok" required>
        <option value="">{quote.choose}</option>
        {wish.timeframes.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
    </div>
    <fieldset class="field">
      <legend>{wish.subsidy}</legend>
      <div class="choices choices-inline">
        {
          wish.subsidyChoices.map((choice, index) => (
            <label class="choice">
              <input type="radio" name="subvencija" value={choice.value} required={index === 0} />
              <span>{choice.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="field">
      <label for="sporocilo">{wish.message} <span class="optional">({quote.optional})</span></label>
      <textarea id="sporocilo" name="sporocilo" rows="4" maxlength="2000" aria-describedby="sporocilo-hint"></textarea>
      <p class="hint" id="sporocilo-hint">{wish.messageHint}</p>
    </div>
  </fieldset>

  <fieldset class="form-step">
    <legend>{step(4, contact.legend)}</legend>
    <div class="field">
      <label for="ime">{contact.name}</label>
      <input id="ime" name="ime" type="text" autocomplete="name" required />
    </div>
    <p class="hint" id="reach-hint">{contact.reachHint}</p>
    <div class="field">
      <label for="telefon">{contact.phone}</label>
      <input id="telefon" name="telefon" type="tel" autocomplete="tel" aria-describedby="reach-hint" />
    </div>
    <div class="field">
      <label for="eposta">{contact.email}</label>
      <input id="eposta" name="eposta" type="email" autocomplete="email" aria-describedby="reach-hint" />
    </div>
    <div class="field consent">
      <input id="soglasje" name="soglasje" type="checkbox" value="da" required />
      <label for="soglasje">
        {contact.consentBefore}<a href={localizedPath(lang, LEGAL_PATHS.privacy)}>{contact.consentLink}</a>{contact.consentAfter}
      </label>
    </div>
  </fieldset>

  <div class="form-challenge" data-turnstile hidden></div>

  <div class="form-submit">
    <button class="button button-large" type="submit" disabled>{quote.submit}</button>
    <p class="hint">{t(lang, "cta.free")}</p>
    <p class="form-off" id="form-off">{quote.formOff}</p>
  </div>
</form>

<script>
  import { loadConfig } from "../lib/config";
  import { formTarget } from "../lib/quote-form";

  const TURNSTILE_SCRIPT = "https://challenges.cloudflare.com/turnstile/v0/api.js";

  async function connect(form: HTMLFormElement) {
    const target = formTarget(await loadConfig());
    const challenge = form.querySelector<HTMLElement>("[data-turnstile]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!target || !challenge || !button) return;

    form.action = target.action;
    const widget = document.createElement("div");
    widget.className = "cf-turnstile";
    widget.dataset.sitekey = target.siteKey;
    widget.dataset.action = form.dataset.turnstileAction ?? "";
    widget.dataset.theme = "light";
    challenge.append(widget);
    challenge.hidden = false;

    const script = document.createElement("script");
    script.src = TURNSTILE_SCRIPT;
    script.async = true;
    document.head.append(script);

    button.disabled = false;
    form.removeAttribute("aria-describedby");
    form.querySelector("#form-off")?.remove();
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-quote-form]")) void connect(form);
</script>
