---
// "What is included" (or not): a list with a mark per item, in two columns on
// a wide screen. The marks are decoration (CSS); the list carries the meaning.
interface Props {
  heading: string;
  id: string;
  items: string[];
  lead?: string;
  /** Mark the items as left out (a dash instead of a check). */
  excluded?: boolean;
}

const { heading, id, items, lead, excluded = false } = Astro.props;
---

<section class="band" aria-labelledby={id}>
  <div class="wrap">
    <h2 id={id}>{heading}</h2>
    {lead && <p class="lead">{lead}</p>}
    <ul class:list={["checklist", { "checklist-excluded": excluded }]}>
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
